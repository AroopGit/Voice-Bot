# SwiftShip Voice Bot Configuration

# === Required API Keys ===
GROQ_API_KEY=your_groq_api_key_here

# === Qdrant Vector Database ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=swiftship_knowledge

# === Model Configuration ===
# Whisper models: tiny, base, small, medium, large-v2
# Smaller = faster, larger = more accurate
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Embedding model (multilingual support)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# === LLM Configuration ===
# Fast model for quick responses
LLM_MODEL_FAST=llama-3.1-8b-instant
# Quality model for complex queries
LLM_MODEL_QUALITY=llama-3.1-70b-versatile
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7

# === RAG Configuration ===
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# === TTS Configuration ===
TTS_DEFAULT_VOICE=en-US-JennyNeural
TTS_RATE=+10%
TTS_VOLUME=+0%

# === Server Configuration ===
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
